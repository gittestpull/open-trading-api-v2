# ===================================
# Trading Bot Environment Variables
# ===================================
# Copy this file to .env and fill in the values

# Web Dashboard
DASHBOARD_PASSWORD=your_secure_password_here
WEB_PORT=8080
ENV_TYPE=prod  # prod, staging, dev

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# OpenAI API (for AI analyst)
OPENAI_API_KEY=sk-your_openai_api_key

# YouTube API (for news collection)
YOUTUBE_API_KEY=your_youtube_api_key

# DART API (for financial data - optional)
DART_API_KEY=your_dart_api_key

# KIS API (set in kis_devlp.yaml, but can override here)
# KIS_APP_KEY=your_kis_app_key
# KIS_APP_SECRET=your_kis_app_secret

# Public IP (for external access)
# PUBLIC_IP=your_public_ip
